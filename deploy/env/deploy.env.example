# Deployment variables for MXA Transcription
# Copy to deploy/env/deploy.env and adjust for your environment.
# Usage:
#   export DEPLOY_ENV_FILE=/absolute/path/to/deploy/env/deploy.env
#   sudo ./deploy/scripts/deploy-master.sh frontend

# Repository source
REPO_URL="https://github.com/nkosinathil/mxa-transcription.git"
DEPLOY_BRANCH="main"
GIT_REMOTE_NAME="origin"

# Shared application metadata
APP_NAME="MXA Transcription"
APP_DEBUG="false"
LOG_LEVEL="info"

# Frontend role
FRONTEND_APP_DIR="/var/www/html/mxa-transcription"
FRONTEND_SERVER_NAME="192.168.1.66"
WEB_USER="www-data"
WEB_GROUP="www-data"
APACHE_SITE_NAME="mxa-transcription"
APACHE_LOG_DIR="/var/log/apache2"
PHP_ENV_FILE="/var/www/html/mxa-transcription/php-app/.env"
PHP_APP_URL="http://192.168.1.66"

# Backend role
BACKEND_APP_DIR="/opt/mxa-transcription"
BACKEND_HOST="192.168.1.90"
BACKEND_API_HOST="0.0.0.0"
BACKEND_API_PORT="8000"
APP_USER="mxa"
APP_GROUP="mxa"
PYTHON_BIN="python3"
BACKEND_VENV_DIR="/opt/mxa-transcription/venv"
BACKEND_LOG_DIR="/var/log/mxa-transcription"
PYTHON_ENV_FILE="/opt/mxa-transcription/python-backend/.env"
CELERY_CONCURRENCY="2"

# Database (typically local to the frontend host)
DB_LOCAL="true"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="mxa_transcription"
DB_USER="mxa_transcription"
DB_PASSWORD="change_this_password"
DB_SUPERUSER="postgres"
DATABASE_URL="postgresql://mxa_transcription:change_this_password@127.0.0.1:5432/mxa_transcription"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Storage / MinIO
MINIO_BINARY_URL="https://dl.min.io/server/minio/release/linux-amd64/minio"
MINIO_SHA256_URL="https://dl.min.io/server/minio/release/linux-amd64/minio.sha256sum"
MINIO_DATA_DIR="/opt/minio/data"
MINIO_ENDPOINT="localhost:9000"
MINIO_SECURE="False"
MINIO_CONSOLE_ADDRESS=":9001"
MINIO_ROOT_USER="change-me"
MINIO_ROOT_PASSWORD="change-me-long-password"
MINIO_ENV_FILE="/etc/mxa-transcription/minio.env"

# Application integration
API_SECRET_KEY="change-this-to-a-secure-random-string"
PHP_API_BASE_URL="http://192.168.1.90:8000/api/v1"
ALLOWED_ORIGINS="http://192.168.1.66,http://localhost"
KEYCLOAK_SERVER_URL="http://192.168.1.59:8080"
KEYCLOAK_REALM="mxa-transcription"
KEYCLOAK_CLIENT_ID="mxa-transcription-client"
KEYCLOAK_CLIENT_SECRET="set-after-keycloak-client-creation"
KEYCLOAK_REDIRECT_URI="http://192.168.1.66/auth/callback"

# Transcription settings
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="int8"
DIARIZATION_ENABLED="True"
HUGGINGFACE_TOKEN=""
MAX_UPLOAD_SIZE="524288000"

# Keycloak role
KEYCLOAK_VERSION="21.1.2"
KEYCLOAK_USER="keycloak"
KEYCLOAK_GROUP="keycloak"
KEYCLOAK_DIR="/opt/keycloak"
KEYCLOAK_HOSTNAME="192.168.1.59"
KEYCLOAK_HTTP_PORT="8080"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="change-this-immediately"
KEYCLOAK_ENV_FILE="/etc/mxa-transcription/keycloak.env"

# Optional package overrides
PHP_PACKAGES="apache2 php php-cli php-common php-curl php-mbstring php-pgsql php-xml libapache2-mod-php postgresql postgresql-client git curl unzip ca-certificates"
BACKEND_PACKAGES="python3 python3-venv python3-pip redis-server git curl wget ffmpeg build-essential libpq-dev libsndfile1 ca-certificates"
KEYCLOAK_PACKAGES="openjdk-17-jre-headless curl unzip wget ca-certificates"
