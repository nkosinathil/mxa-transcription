# Shared deployment environment variables
# ---------------------------------------
# Copy to scripts/deploy/env.sh and fill values once:
#   cp scripts/deploy/env.example scripts/deploy/env.sh
#
# Then run on each server:
#   sudo ./scripts/deploy/deploy.sh --config ./scripts/deploy/env.sh --role <sso|python|app>
#
# NOTE: this file contains secrets. Keep it private and never commit env.sh.

# Common
export NON_INTERACTIVE=true
export APP_URL="https://transcription.gismartanalytics.com"
export APP_SERVER_IP="192.168.1.66"
export PYTHON_SERVER_IP="192.168.1.90"
export SSO_SERVER_IP="192.168.1.59"

# Shared secret between App and Python
export SHARED_API_KEY="replace-with-random-64-hex"

# App/PostgreSQL
export DB_NAME="transcription_db"
export DB_USER="transcription_user"
export DB_PASS="replace-with-strong-db-password"

# MinIO
export MINIO_ACCESS_KEY="replace-with-minio-access-key"
export MINIO_SECRET_KEY="replace-with-minio-secret-key"

# SSO / Keycloak
export KEYCLOAK_REALM="mxa"
export KEYCLOAK_CLIENT_ID="transcription-web"
export KEYCLOAK_CLIENT_SECRET="replace-with-keycloak-client-secret"
export KC_ADMIN="admin"
export KC_ADMIN_PASS="replace-with-keycloak-admin-password"
export KC_DB_NAME="keycloak_db"
export KC_DB_USER="keycloak_user"
export KC_DB_PASS="replace-with-keycloak-db-password"
export KC_VERSION="26.1.3"

# Python
export PY_DIR="/opt/mxa-transcription/python-backend"
export ENV_FILE="/opt/mxa-transcription/python-backend/.env"
export SERVICE_USER="transcription"
export APP_HOST="0.0.0.0"
export APP_PORT="8000"
export REDIS_URL="redis://localhost:6379/0"
export CORS_ORIGINS="${APP_URL}"

# Derived values (normally no need to change)
export KEYCLOAK_BASE_URL="http://${SSO_SERVER_IP}:8080"
export PYTHON_API_BASE_URL="http://${PYTHON_SERVER_IP}:8000"
export MINIO_ENDPOINT="${PYTHON_SERVER_IP}:9000"
export PYTHON_API_KEY="${SHARED_API_KEY}"
export API_SECRET_KEY="${SHARED_API_KEY}"
export POSTGRES_DSN="postgresql://${DB_USER}:${DB_PASS}@${APP_SERVER_IP}:5432/${DB_NAME}"
