# python-backend/.env.example
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# Plain-language:
#   Each line is a variable name = value pair.
#   The Python application reads these at startup via pydantic-settings.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
APP_NAME=MXA Transcription API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost

# -----------------------------------------------------------------------
# Internal API key
# The PHP app sends this in the X-Api-Key header on every request.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------
API_SECRET_KEY=replace-with-a-long-random-string

# -----------------------------------------------------------------------
# Redis (Celery broker + result backend)
# Format: redis://:password@host:port/db_number
# -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------
# MinIO object storage
# -----------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_AUDIO_BUCKET=audio-uploads
MINIO_RESULTS_BUCKET=transcription-results
MINIO_EXPORTS_BUCKET=exports

# -----------------------------------------------------------------------
# PostgreSQL connection string
# Used by the Celery worker to write job events / results
# Format: postgresql://user:password@host:port/database
# -----------------------------------------------------------------------
POSTGRES_DSN=postgresql://transcription_user:your_password@192.168.1.66:5432/transcription_db

# -----------------------------------------------------------------------
# HuggingFace token for speaker diarization (pyannote.audio)
# Get your token at: https://huggingface.co/settings/tokens
# You must also accept the pyannote/speaker-diarization-3.1 model terms.
# Leave blank to disable diarization.
# -----------------------------------------------------------------------
HUGGINGFACE_TOKEN=

# -----------------------------------------------------------------------
# Processing defaults
# -----------------------------------------------------------------------
DEFAULT_MODEL_SIZE=base
DEFAULT_DEVICE=auto
MAX_UPLOAD_BYTES=524288000
