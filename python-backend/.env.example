# Environment variables for Python backend
# Copy this file to .env and configure

# API Settings
API_SECRET_KEY=change-this-to-a-secure-random-string-in-production
DEBUG=False
ALLOWED_ORIGINS=http://192.168.1.66,http://localhost

# Database
DATABASE_URL=postgresql://mxa_transcription:password@192.168.1.66:5432/mxa_transcription

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False

# Transcription
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
DIARIZATION_ENABLED=True
HUGGINGFACE_TOKEN=your_huggingface_token_here

# File Upload
MAX_UPLOAD_SIZE=524288000
