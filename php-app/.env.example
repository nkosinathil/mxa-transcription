# PHP Application environment variables
# Copy to .env and fill in real values before deploying

APP_NAME="MXA Transcription"
APP_URL=http://192.168.1.66
APP_DEBUG=false

# PostgreSQL
DB_HOST=192.168.1.66
DB_PORT=5432
DB_NAME=mxa_transcription
DB_USER=mxa_transcription
DB_PASSWORD=change_this_password

# Python API (Server 2)
API_BASE_URL=http://192.168.1.90:8000/api/v1
API_SECRET_KEY=change-this-to-match-python-backend-key

# Keycloak (Server 3)
KEYCLOAK_SERVER_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=mxa-transcription
KEYCLOAK_CLIENT_ID=mxa-transcription-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here
KEYCLOAK_REDIRECT_URI=http://192.168.1.66/auth/callback

# Logging
LOG_LEVEL=info
