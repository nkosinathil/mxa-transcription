# php-app/.env.example
#
# Copy this file to .env on the application server.
# NEVER commit the real .env to version control.
#
# Plain-language:
#   These variables configure the PHP web application.
#   They are loaded at startup by the vlucas/phpdotenv package.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
APP_NAME="MXA Transcription"
APP_ENV=production
APP_URL=http://192.168.1.66
APP_DEBUG=false
APP_LOG_LEVEL=warning

# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------
SESSION_NAME=mxa_session
SESSION_LIFETIME=7200
# Generate: php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=Lax

# -----------------------------------------------------------------------
# PostgreSQL database
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcription_db
DB_USER=transcription_user
DB_PASS=replace-with-your-db-password

# -----------------------------------------------------------------------
# Keycloak OIDC
# Realm and client details from your Keycloak admin console.
# -----------------------------------------------------------------------
KEYCLOAK_BASE_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=your-realm-name
KEYCLOAK_CLIENT_ID=transcription-web
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret
# Must match the Redirect URI configured in Keycloak
KEYCLOAK_REDIRECT_URI=http://192.168.1.66/auth/callback
KEYCLOAK_VERIFY_TLS=true

# -----------------------------------------------------------------------
# Python API (running on the Python server)
# -----------------------------------------------------------------------
PYTHON_API_BASE_URL=http://192.168.1.90:8000
PYTHON_API_KEY=replace-with-same-key-as-python-env

# -----------------------------------------------------------------------
# MinIO (for generating pre-signed download URLs from PHP)
# -----------------------------------------------------------------------
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_AUDIO_BUCKET=audio-uploads
MINIO_RESULTS_BUCKET=transcription-results
MINIO_EXPORTS_BUCKET=exports

# -----------------------------------------------------------------------
# CSRF protection
# -----------------------------------------------------------------------
CSRF_TOKEN_LIFETIME=3600
